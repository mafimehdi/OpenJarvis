#property strict
#property copyright "Test"

//--- این سه تابع رویداد برای MQL4 الزامی هستند ---

int OnInit()
{
   Print("TEST_MINIMAL: کامپایل موفق بود و اکسپرت اجرا شد.");
   Alert("TEST_MINIMAL: کار می‌کند ✅");
   return(INIT_SUCCEEDED);
}

void OnTick()
{
   // هیچ کاری نمی‌کند — فقط برای رفع الزام MQL4
}

void OnDeinit(const int reason)
{
   Print("TEST_MINIMAL: پایان — دلیل: ", reason);
}
